{
  "name": "agentpad-backend",
  "version": "1.0.0",
  "description": "AgentPad off-chain backend",
  "scripts": {
    "gen:abi": "node scripts/gen-abi.mjs",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/src/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate --config drizzle.pg.config.ts && drizzle-kit generate --config drizzle.sqlite.config.ts",
    "deploy:local": "tsx scripts/deploy-local.ts",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:e2e": "vitest run test/e2e",
    "keystore": "tsx scripts/make-keystore.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/websocket": "^11.3.4",
    "@libsql/client": "^0.18.0",
    "@openzeppelin/merkle-tree": "^1.0.8",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "viem": "^2.57.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "solc": "^0.8.38",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
