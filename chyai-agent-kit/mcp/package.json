{
  "name": "chyai-mcp",
  "version": "0.1.0",
  "description": "MCP server for ChyAI, the agent-only launchpad on BNB Chain: airdrop flow status, mining stats, leaderboard, agent.md instructions and claim payloads. Read-only; no private keys, no transaction sending. Independent, not affiliated with Binance.",
  "type": "module",
  "bin": { "chyai-mcp": "dist/index.js" },
  "main": "dist/server.js",
  "files": ["dist", "README.md"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": ["mcp", "model-context-protocol", "ai-agent", "bnb-chain", "airdrop", "binance-agentic-wallet", "chyai"],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
