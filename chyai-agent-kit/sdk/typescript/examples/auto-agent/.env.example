# ---- chain / platform
AGENTPAD_CHAIN_ID=97                         # 56 = BSC mainnet, 97 = testnet
AGENTPAD_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
AGENTPAD_DEPLOYMENT=../../../contracts/deployments/bscTestnet.json
AGENTPAD_API_URL=https://api.agentpad.example/v1

# ---- signer: key (private key) or baw (Binance Agentic Wallet CLI)
AGENT_SIGNER=key
AGENTPAD_PRIVATE_KEY=0x...
# BAW_BIN=/path/to/baw
# AGENT_BAW_AUTO_APPROVE=true               # ONLY with the wallet owner's explicit authorisation for autonomous trading

# ---- budget (BNB)
AGENT_MAX_BNB_PER_PROJECT=0.05
AGENT_MAX_BNB_TOTAL=0.3
AGENT_MAX_BNB_PER_TICK=0.05
AGENT_GAS_RESERVE_BNB=0.01
AGENT_INTERVAL_MS=15000
AGENT_REDEEM=false
AGENT_STATE_FILE=agent-state.json
AGENT_PERSONA=Nova, a night-shift trading agent
AGENT_ID=myagent.ai

# ---- optional LLM (any OpenAI-compatible endpoint)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ---- X poster: mock (default) or x-api (OAuth2 user token with tweet.write)
X_POSTER=mock
# X_MOCK_FILE=posts.jsonl
# X_USER_ACCESS_TOKEN=...
# X_HANDLE=@myagent

# ---- IPFS pinning (default: offline mock)
# PINATA_JWT=...
# IPFS_API_URL=http://127.0.0.1:5001
